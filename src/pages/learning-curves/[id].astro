---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import SyndicationBar from '../../components/SyndicationBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { render } from 'astro:content';
import { getPublishedLearnings } from '../../utils/content';
import { getTechArticleSchema, getSiteRootUrl } from '../../utils/schema';
import { resolvePath } from '../../utils/paths';

export async function getStaticPaths() {
  const learnings = await getPublishedLearnings();
  return learnings.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const siteUrl = getSiteRootUrl(Astro.site);
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(entry.data.date);

const levelVariant = {
  Steep: 'danger',
  Moderate: 'warning',
  Smooth: 'success',
}[entry.data.curveLevel] as 'danger' | 'warning' | 'success';
---

<Layout
  title={`${entry.data.title} | Learning Curve`}
  description={entry.data.subtitle}
  showReadingProgress={true}
  jsonLd={getTechArticleSchema(siteUrl, entry)}
>
  <article class="site-container-reading space-y-8">
    <!-- Breadcrumb -->
    <div>
      <a href={resolvePath('/learning-curves')} class="hig-filter-pill">
        <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_back</span>
        <span>All learning curves</span>
      </a>
    </div>

    <!-- Header -->
    <header class="space-y-4 border-b border-[var(--color-border)] pb-8">
      <div class="flex flex-wrap items-center gap-2.5">
        <DomainBadge label={entry.data.topic} id={entry.id} showCode={true} />
        <Badge variant={levelVariant} size="sm">
          {entry.data.curveLevel} curve
        </Badge>
        <span class="text-[12px] text-[var(--color-text-muted)] font-mono-tabular">{formattedDate}</span>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl text-[var(--color-text-main)] leading-[1.12] max-w-4xl">
        {entry.data.title}
      </h1>

      <p class="text-[17px] text-[var(--color-text-secondary)] leading-relaxed max-w-3xl">
        {entry.data.subtitle}
      </p>

      <!-- Key Obstacle & Breakthrough callouts -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
        <div class="mantra-card p-5 space-y-1.5">
          <div class="text-[13px] font-medium text-[var(--color-negative)] flex items-center gap-1.5">
            <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">error</span>
            <span>Obstacle encountered</span>
          </div>
          <p class="text-[13px] text-[var(--color-text-secondary)] leading-relaxed">
            {entry.data.obstacle}
          </p>
        </div>

        <div class="mantra-card p-5 space-y-1.5 border-[var(--color-cr-border)]">
          <div class="text-[13px] font-medium text-[var(--color-positive)] flex items-center gap-1.5">
            <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">check_circle</span>
            <span>Diagnostic breakthrough</span>
          </div>
          <p class="text-[13px] text-[var(--color-text-secondary)] leading-relaxed">
            {entry.data.breakthrough}
          </p>
        </div>
      </div>

      <!-- Core Takeaways Checklist -->
      {entry.data.takeaways && entry.data.takeaways.length > 0 && (
        <div class="mantra-card p-5 mt-4 space-y-3">
          <div class="text-[13px] font-medium text-[var(--color-brand)] flex items-center gap-1.5">
            <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">verified</span>
            <span>Permanent engineering heuristics</span>
          </div>
          <ul class="space-y-2 text-[13px] text-[var(--color-text-main)]">
            {entry.data.takeaways.map((takeaway) => (
              <li class="flex items-start gap-2.5">
                <span class="material-symbols-outlined !text-[16px] text-[var(--color-brand)] shrink-0 mt-0.5" aria-hidden="true">check</span>
                <span>{takeaway}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {entry.data.tags.map((tag) => (
          <Badge variant="subtle" size="sm">{tag}</Badge>
        ))}
      </div>
    </header>

    <!-- Main Content + Sticky Table of Contents -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8 space-y-8">
        <div class="mantra-card p-6 sm:p-10 prose-content">
          <Content />
        </div>

        <SyndicationBar
          title={entry.data.title}
          description={entry.data.subtitle}
          tags={entry.data.tags}
          type="learning-curve"
        />

        <!-- Bottom navigation -->
        <div class="pt-4 flex flex-wrap items-center justify-between gap-4">
          <a href={resolvePath('/learning-curves')} class="hig-btn hig-btn-glass">
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_back</span>
            <span>Back to all curves</span>
          </a>
          <a href={resolvePath('/works')} class="hig-btn hig-btn-tinted">
            <span>See production works</span>
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-4">
        <TableOfContents headings={headings} stamp="LC // TOC" />
      </div>
    </div>
  </article>
</Layout>
