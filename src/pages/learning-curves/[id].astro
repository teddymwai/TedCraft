---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import SyndicationBar from '../../components/SyndicationBar.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const learnings = await getCollection('learnings');
  return learnings.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(entry.data.date);

const levelVariant = {
  Steep: 'danger',
  Moderate: 'warning',
  Smooth: 'success',
}[entry.data.curveLevel] as 'danger' | 'warning' | 'success';
---

<Layout
  title={`${entry.data.title} | Learning Curve`}
  description={entry.data.subtitle}
>
  <article class="site-container max-w-3xl space-y-8">
    <!-- Breadcrumb -->
    <div>
      <a href="/learning-curves" class="text-xs font-semibold text-[var(--color-brand)] hover:underline inline-flex items-center gap-1">
        ← Back to all learning curves
      </a>
    </div>

    <!-- Header -->
    <header class="space-y-4 border-b border-[var(--color-border)] pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="brand" size="sm">{entry.data.topic}</Badge>
        <Badge variant={levelVariant} size="sm">
          Curve Level: {entry.data.curveLevel}
        </Badge>
        <span class="text-xs text-[var(--color-text-muted)] font-mono">{formattedDate}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-[var(--color-text-main)]">
        {entry.data.title}
      </h1>

      <p class="text-lg text-[var(--color-text-muted)] leading-relaxed">
        {entry.data.subtitle}
      </p>

      <!-- Key Obstacle & Breakthrough callouts -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 dark:bg-rose-950/20 p-4">
          <div class="text-xs font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400 mb-1 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            The Obstacle (The Wall)
          </div>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            {entry.data.obstacle}
          </p>
        </div>

        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 dark:bg-emerald-950/20 p-4">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
            The Breakthrough
          </div>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            {entry.data.breakthrough}
          </p>
        </div>
      </div>

      <!-- Core Takeaways Checklist -->
      {entry.data.takeaways && entry.data.takeaways.length > 0 && (
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 mt-4">
          <div class="text-xs font-bold uppercase tracking-wider text-[var(--color-brand)] mb-3 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Permanent Engineering Takeaways
          </div>
          <ul class="space-y-2 text-xs text-[var(--color-text-main)]">
            {entry.data.takeaways.map((takeaway) => (
              <li class="flex items-start gap-2">
                <span class="text-[var(--color-brand)] font-bold">✓</span>
                <span>{takeaway}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {entry.data.tags.map((tag) => (
          <Badge variant="subtle" size="sm">#{tag}</Badge>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose-content">
      <Content />
    </div>

    <!-- Syndication & Sharing -->
    <SyndicationBar
      title={entry.data.title}
      description={entry.data.subtitle}
      tags={entry.data.tags}
      type="learning-curve"
    />

    <!-- Bottom navigation -->
    <div class="pt-8 border-t border-[var(--color-border)] flex items-center justify-between text-sm">
      <a href="/learning-curves" class="text-[var(--color-brand)] font-semibold hover:underline">
        ← Back to all curves
      </a>
      <a href="/works" class="text-[var(--color-brand)] font-semibold hover:underline">
        See production works →
      </a>
    </div>
  </article>
</Layout>
