---
import Layout from '../../layouts/Layout.astro';
import LearningCard from '../../components/LearningCard.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';

const allLearnings = await getCollection('learnings');
const sortedLearnings = allLearnings.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const curveLevels = ['All', 'Steep', 'Moderate', 'Smooth'];
---

<Layout
  title="Learning Curves & Engineering Post-Mortems | Ted's Notebook"
  description="Honest field notes on tough architectural puzzles, subtle bugs, and the turning points that resolved them."
>
  <div class="site-container space-y-10">
    <!-- Header -->
    <header class="max-w-2xl">
      <Badge variant="warning" size="sm">Field Notes & Mental Models</Badge>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-[var(--color-text-main)] mt-2">
        The Learning Curves Ledger
      </h1>
      <p class="text-base text-[var(--color-text-muted)] mt-3 leading-relaxed">
        Polished project releases only tell half the story. This ledger catalogs the confusing deadlocks, the false assumptions, and the mental model shifts that actually built my engineering reflexes.
      </p>
    </header>

    <!-- Difficulty / Curve Filter -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--color-border)] pb-4">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-[var(--color-text-muted)] mr-1">Filter by Curve:</span>
        {curveLevels.map((lvl, idx) => (
          <button
            type="button"
            class={`curve-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer border ${
              idx === 0
                ? 'active bg-[var(--color-brand)] text-white border-[var(--color-brand)]'
                : 'border-[var(--color-border)] bg-[var(--color-bg-card)] text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] hover:bg-[var(--color-bg-subtle)]'
            }`}
            data-level={lvl}
          >
            {lvl}
          </button>
        ))}
      </div>

      <div class="text-xs text-[var(--color-text-muted)] font-mono">
        Showing {sortedLearnings.length} documented curves
      </div>
    </div>

    <!-- Cards List -->
    <div id="learnings-list" class="grid grid-cols-1 gap-6">
      {sortedLearnings.map((item) => (
        <div class="learning-item" data-level={item.data.curveLevel}>
          <LearningCard
            id={item.id}
            title={item.data.title}
            subtitle={item.data.subtitle}
            topic={item.data.topic}
            curveLevel={item.data.curveLevel}
            obstacle={item.data.obstacle}
            breakthrough={item.data.breakthrough}
            takeaways={item.data.takeaways}
            tags={item.data.tags}
            date={item.data.date}
          />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  function setupCurveFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.curve-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('.learning-item');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lvl = btn.getAttribute('data-level');

        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-[var(--color-brand)]', 'text-white', 'border-[var(--color-brand)]');
          b.classList.add('border-[var(--color-border)]', 'bg-[var(--color-bg-card)]', 'text-[var(--color-text-muted)]');
        });

        btn.classList.add('active', 'bg-[var(--color-brand)]', 'text-white', 'border-[var(--color-brand)]');
        btn.classList.remove('border-[var(--color-border)]', 'bg-[var(--color-bg-card)]', 'text-[var(--color-text-muted)]');

        items.forEach((item) => {
          if (lvl === 'All' || item.getAttribute('data-level') === lvl) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  }

  setupCurveFilters();
  document.addEventListener('astro:after-swap', setupCurveFilters);
</script>
