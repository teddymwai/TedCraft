---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';

const toolkit = [
  {
    category: 'Security & Risk Governance',
    items: ['Role-Based Access Control (RBAC)', 'Enterprise GRC Liaison', 'AI Risk Evaluation', 'UAM Audit Automation', 'SIEM & SOC Alert Engineering'],
  },
  {
    category: 'Automation & Verification',
    items: ['Python & Playwright', 'HAR Wire Contract Testing', 'OpenStack API Automation', 'OpenVPN & L3/L4 Tunneling', 'Deterministic Mutation Guards'],
  },
  {
    category: 'Infrastructure & Tools',
    items: ['Linux (LPIC-1) & POSIX Bash', 'Cisco IOS & Colocation', 'Docker & Containerization', 'Go & REST APIs', 'Git & CI/CD Pipelines'],
  },
];

const results = [
  {
    metric: '0 Incidents in 18 Mos',
    label: 'Access Governance',
    detail: 'Zero unauthorized access or privilege escalation incidents across 50+ environments for 150+ internal users and 1,000+ client operators.',
  },
  {
    metric: '17 Days → 13 Hours',
    label: 'Audit Cycle Compression',
    detail: 'Engineered Python UAM automation tool that slashed quarterly user access review turnaround from 17 days to 13 business hours.',
  },
  {
    metric: '0 Regressions',
    label: 'Production Releases',
    detail: 'Zero critical regressions reached production across 5 consecutive major platform releases of CYBER RANGES via RangeMaster Cockpit.',
  },
  {
    metric: '$400K - $450K Protected',
    label: 'Revenue Exposure',
    detail: 'Identified privilege revocation latency as an executive metric, driving deprovisioning latency from days down to under 2 hours.',
  },
];

const principles = [
  {
    title: 'Test Below the UI (Wire Contracts Win)',
    description: 'A green button in the DOM does not prove your system is safe. Frontend state caches mask silent API corruptions. Real verification happens at the network protocol and schema layer.',
  },
  {
    title: 'Trace to the Root Cause, Never Patch Symptoms',
    description: 'Bumping timeouts or adding artificial sleeps to flaky tests merely conceals underlying race conditions and lock contentions. True reliability comes from diagnosing the underlying operating system and database mechanisms.',
  },
  {
    title: 'Access Control is an Active Perimeter',
    description: 'Periodic quarterly reviews create a false sense of security. Least-privilege governance must be continuous, automated, and evaluated against quantifiable revocation latency.',
  },
];
---

<Layout
  title="About Thaddeus (Ted) Mwai | Security QA Lead & Risk Strategist"
  description="Security QA Lead, Risk Strategist, and Systems Automation Engineer at CYBER RANGES. 5+ years across test automation, access governance, and technology risk."
>
  <div class="site-container max-w-3xl space-y-12">
    <!-- Intro -->
    <header class="space-y-4">
      <div class="flex items-center gap-2">
        <Badge variant="brand" size="sm">CYBER RANGES</Badge>
        <span class="text-xs text-[var(--color-text-muted)] font-mono">Nairobi, Kenya • Stafford, VA</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-[var(--color-text-main)]">
        Thaddeus (Ted) Wachira Mwai
      </h1>

      <p class="text-lg text-[var(--color-brand)] font-semibold">
        Security QA Lead & Cross-Functional Risk Strategist
      </p>

      <p class="text-base text-[var(--color-text-muted)] leading-relaxed">
        I lead quality assurance at <strong class="text-[var(--color-text-main)]">CYBER RANGES</strong>, a premier cybersecurity training and drill platform used by 200+ client organizations worldwide. I also serve as the department's risk liaison to the central Governance, Risk, and Compliance (GRC) function.
      </p>
    </header>

    <!-- Key Results Strip -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {results.map((r) => (
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 space-y-2">
          <div class="text-xs font-bold uppercase tracking-wider text-[var(--color-brand)]">{r.label}</div>
          <div class="text-xl font-black text-[var(--color-text-main)]">{r.metric}</div>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">{r.detail}</p>
        </div>
      ))}
    </section>

    <!-- Detailed Bio -->
    <section class="space-y-4 text-sm leading-relaxed text-[var(--color-text-main)]">
      <h2 class="text-xl font-bold tracking-tight text-[var(--color-text-main)] border-b border-[var(--color-border)] pb-2">
        Background & Focus
      </h2>
      <p>
        My work centers on three critical pillars: <strong>finding platform failures before clients do</strong>, <strong>strictly governing who can touch what</strong>, and <strong>turning scattered operational anomalies into ranked risk registers that leadership can act on</strong>.
      </p>
      <p>
        I architect the automation I rely on—authoring high-assurance Python and Playwright verification platforms like <strong>RangeMaster Cockpit</strong>, which validates multi-tenant CloudTemplate stacks and enforces wire contracts against certified Golden Baselines.
      </p>
      <p>
        Prior to leading QA at CYBER RANGES, I worked in cybersecurity consulting and SOC optimization at <strong>Silensec Africa</strong> (tuning SIEM detection rules and building automated access review engines), compliance auditing at <strong>Simplify IT</strong> (verifying cloud IAM policies across AWS, Azure, and GCP), and enterprise systems administration at <strong>Avery East Africa</strong> (deploying Cisco networks and enforcing digital security policies for government PPP contracts).
      </p>
    </section>

    <!-- Engineering Principles -->
    <section class="space-y-6">
      <h2 class="text-xl font-bold tracking-tight text-[var(--color-text-main)] border-b border-[var(--color-border)] pb-2">
        Engineering Philosophy
      </h2>
      <div class="grid grid-cols-1 gap-4">
        {principles.map((p) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5">
            <h3 class="text-sm font-bold text-[var(--color-text-main)] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[var(--color-brand)]"></span>
              {p.title}
            </h3>
            <p class="mt-2 text-xs text-[var(--color-text-muted)] leading-relaxed">
              {p.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Toolkit -->
    <section class="space-y-6">
      <h2 class="text-xl font-bold tracking-tight text-[var(--color-text-main)] border-b border-[var(--color-border)] pb-2">
        Core Competencies & Toolkit
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {toolkit.map((group) => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4">
            <div class="text-xs font-bold text-[var(--color-brand)] uppercase tracking-wider mb-3">
              {group.category}
            </div>
            <ul class="space-y-1.5 text-xs text-[var(--color-text-main)]">
              {group.items.map((item) => (
                <li class="flex items-center gap-1.5">
                  <span class="text-[var(--color-text-muted)]">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Connect / Contact -->
    <section class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 space-y-4">
      <h2 class="text-lg font-bold text-[var(--color-text-main)]">
        Get in Touch
      </h2>
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
        I am always open to exchanging field notes on security automation, platform quality engineering, access governance, or technology risk:
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="mailto:thaddeusmwai.9974@gmail.com"
          class="px-4 py-2 rounded-lg bg-[var(--color-brand)] text-white text-xs font-semibold hover:bg-[var(--color-brand-hover)] transition-colors"
        >
          Email Me (thaddeusmwai.9974@gmail.com)
        </a>
        <a
          href="https://www.linkedin.com/in/teddymwai/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] text-xs font-semibold hover:text-[var(--color-brand)] transition-colors"
        >
          LinkedIn (/in/teddymwai)
        </a>
        <a
          href="https://github.com/teddymwai"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] text-xs font-semibold hover:text-[var(--color-brand)] transition-colors"
        >
          GitHub (teddymwai)
        </a>
      </div>
    </section>
  </div>
</Layout>
