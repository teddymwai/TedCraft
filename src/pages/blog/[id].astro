---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import SyndicationBar from '../../components/SyndicationBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { render } from 'astro:content';
import { getPublishedPosts } from '../../utils/content';
import { getBlogPostingSchema, getSiteRootUrl } from '../../utils/schema';
import { resolvePath } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const siteUrl = getSiteRootUrl(Astro.site);
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(entry.data.pubDate);
---

<Layout
  title={`${entry.data.title} | Articles`}
  description={entry.data.description}
  showReadingProgress={true}
  jsonLd={getBlogPostingSchema(siteUrl, entry)}
>
  <article class="site-container-reading space-y-8">
    <!-- Breadcrumb -->
    <div>
      <a href={resolvePath('/blog')} class="hig-filter-pill">
        <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_back</span>
        <span>All articles</span>
      </a>
    </div>

    <!-- Header -->
    <header class="space-y-4 border-b border-[var(--color-border)] pb-8 max-w-4xl">
      <div class="flex items-center gap-3 text-[12px] text-[var(--color-text-muted)] font-mono-tabular">
        <span class="text-[var(--color-brand)]">ESSAY // DISPATCH</span>
        <span>·</span>
        <time>{formattedDate}</time>
        <span>·</span>
        <span>{entry.data.readTime}</span>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl text-[var(--color-text-main)] leading-[1.12]">
        {entry.data.title}
      </h1>

      <p class="text-[17px] text-[var(--color-text-secondary)] leading-relaxed">
        {entry.data.description}
      </p>

      <div class="flex flex-wrap gap-2 pt-2">
        {entry.data.tags.map((tag) => (
          <Badge variant="subtle" size="sm">{tag}</Badge>
        ))}
      </div>
    </header>

    <!-- Main Content + Sticky Table of Contents Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8 space-y-8">
        <div class="mantra-card p-6 sm:p-10 prose-content">
          <Content />
        </div>

        <SyndicationBar
          title={entry.data.title}
          description={entry.data.description}
          tags={entry.data.tags}
          type="article"
        />

        <!-- Bottom nav -->
        <div class="pt-4 flex flex-wrap items-center justify-between gap-4">
          <a href={resolvePath('/blog')} class="hig-btn hig-btn-glass">
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_back</span>
            <span>Back to all articles</span>
          </a>
          <a href={resolvePath('/learning-curves')} class="hig-btn hig-btn-tinted">
            <span>Explore learning curves</span>
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-4">
        <TableOfContents headings={headings} stamp="ESSAY // TOC" />
      </div>
    </div>
  </article>
</Layout>
