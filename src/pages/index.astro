---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LearningCard from '../components/LearningCard.astro';
import PostCard from '../components/PostCard.astro';
import Badge from '../components/Badge.astro';
import DomainBadge from '../components/DomainBadge.astro';
import { getCollection } from 'astro:content';
import { getHomeGraphSchema, DEFAULT_SITE_URL } from '../utils/schema';
import { resolvePath } from '../utils/paths';

const siteUrl = Astro.site ? Astro.site.toString() : DEFAULT_SITE_URL;

const allWorks = await getCollection('works');
const featuredWorks = allWorks
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allLearnings = await getCollection('learnings');
const recentLearnings = allLearnings
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<Layout
  title="Thaddeus W. Mwai (aka Ted) | TedCraft · Software QA Lead & Senior Risk Strategist"
  description="Software QA Lead and Senior Risk Strategist at CYBER RANGES. Leading quality engineering, access governance, and wire-level verification across 50+ environments."
  jsonLd={getHomeGraphSchema(siteUrl)}
>
  <div class="site-container space-y-16 sm:space-y-24">
    <!-- HERO SECTION (Unslop Pass 6 & 8: Asymmetric Split + Executive Telemetry Dossier Panel) -->
    <section class="pt-4 sm:pt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Narrative Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2.5">
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-positive)]" aria-hidden="true"></span>
            <span class="font-mono-tabular text-[12px] text-[var(--color-text-secondary)]">
              Software QA Lead · Senior Risk Strategist · CYBER RANGES
            </span>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl xl:text-[60px] text-[var(--color-text-main)] leading-[1.06]">
            High-assurance platform verification and engineering field notes
          </h1>

          <p class="text-[16px] sm:text-[18px] leading-[1.6] text-[var(--color-text-secondary)] max-w-2xl">
            I am <strong class="text-[var(--color-text-main)] font-medium">Thaddeus W. Mwai (aka Ted)</strong>, Software QA Lead and Senior Risk Strategist at <strong class="text-[var(--color-text-main)] font-medium">CYBER RANGES</strong>. I govern role-based access across 50+ enterprise environments, architect wire-protocol verification harnesses like <strong class="text-[var(--color-brand)] font-medium">RangeMaster Cockpit</strong>, and document root-cause post-mortems on distributed systems failures.
          </p>

          <!-- Apple HIG Button Hierarchy: 1 Primary + 1 Secondary Capsule CTA, identical 44px height -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a href={resolvePath('/works')} class="hig-btn hig-btn-primary">
              <span>Explore production works</span>
              <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>

            <a href={resolvePath('/learning-curves')} class="hig-btn hig-btn-glass">
              <span class="material-symbols-outlined !text-[18px] text-[var(--color-brand)]" aria-hidden="true">troubleshoot</span>
              <span>Read learning curves</span>
            </a>
          </div>

          <!-- Core Domain Matrix (Official CYBER RANGES Wire Glyphs + Material Symbols) -->
          <div class="pt-6 border-t border-[var(--color-border)] flex flex-wrap items-center gap-2">
            <span class="text-[12px] font-mono-tabular text-[var(--color-text-muted)] mr-1">Verified domains:</span>
            <DomainBadge label="RangeMaster HAR verification" domain="R" showCode={true} />
            <DomainBadge label="OpenStack CloudTemplates" domain="CT" showCode={true} />
            <DomainBadge label="Access governance (UAM)" domain="G" showCode={true} />
            <DomainBadge label="Threat-eX scenarios" domain="SL" showCode={true} />
          </div>
        </div>

        <!-- Right Column: The "One Bright Element" — Executive Verification Telemetry Dossier -->
        <div class="lg:col-span-5 mantra-panel p-6 sm:p-7 space-y-5">
          <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-3.5">
            <div class="flex items-center gap-2 text-[13px] font-medium text-[var(--color-text-main)]">
              <span class="icon-dashboard text-[16px] text-[var(--color-brand)]" aria-hidden="true"></span>
              <span>Verification telemetry dossier</span>
            </div>
            <span class="font-mono-tabular text-[11px] text-[var(--color-brand)] bg-[var(--color-accent-badge)] px-2 py-0.5 rounded-[4px] border border-[var(--color-border-accent)]">
              DOSSIER-TC // 2021–2026
            </span>
          </div>

          <!-- Primary Focal Figure (One Bright Element in Champagne Gold) -->
          <div class="rounded-[12px] bg-[var(--color-bg-subtle)] border border-[var(--color-border-accent)] p-4">
            <div class="flex items-baseline justify-between gap-2">
              <div class="font-mono-tabular text-2xl sm:text-[28px] font-medium text-[var(--color-brand)]">
                $450,000
              </div>
              <span class="font-mono-tabular text-[11px] text-[var(--color-positive)]">
                days to &lt; 2h latency
              </span>
            </div>
            <div class="text-[12px] text-[var(--color-text-secondary)] mt-1">
              Annual revenue exposure mitigated by engineering automated privilege revocation latency tracking
            </div>
          </div>

          <!-- Secondary Telemetry Rows (Aligned Columns & Tabular Figures) -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-4 rounded-[10px] border border-[var(--color-border)] bg-[var(--color-bg-card-solid)]/60 px-4 py-3">
              <div class="flex items-center gap-3">
                <span class="icon-captain text-[16px] text-[var(--color-text-muted)] w-5 text-center" aria-hidden="true"></span>
                <div>
                  <div class="text-[13px] font-medium text-[var(--color-text-main)]">RBAC governance perimeter</div>
                  <div class="text-[11px] text-[var(--color-text-muted)]">50+ environments · 1,000+ client operators</div>
                </div>
              </div>
              <div class="font-mono-tabular text-[13px] font-medium text-[var(--color-positive)] text-right shrink-0">
                0 incidents / 18m
              </div>
            </div>

            <div class="flex items-center justify-between gap-4 rounded-[10px] border border-[var(--color-border)] bg-[var(--color-bg-card-solid)]/60 px-4 py-3">
              <div class="flex items-center gap-3">
                <span class="icon-cloud-template text-[16px] text-[var(--color-text-muted)] w-5 text-center" aria-hidden="true"></span>
                <div>
                  <div class="text-[13px] font-medium text-[var(--color-text-main)]">RangeMaster release gate</div>
                  <div class="text-[11px] text-[var(--color-text-muted)]">5 consecutive major platform releases</div>
                </div>
              </div>
              <div class="font-mono-tabular text-[13px] font-medium text-[var(--color-text-main)] text-right shrink-0">
                0 regressions
              </div>
            </div>

            <div class="flex items-center justify-between gap-4 rounded-[10px] border border-[var(--color-border)] bg-[var(--color-bg-card-solid)]/60 px-4 py-3">
              <div class="flex items-center gap-3">
                <span class="icon-assessment text-[16px] text-[var(--color-text-muted)] w-5 text-center" aria-hidden="true"></span>
                <div>
                  <div class="text-[13px] font-medium text-[var(--color-text-main)]">Quarterly UAM access review</div>
                  <div class="text-[11px] text-[var(--color-text-muted)]">Automated Python audit correlation</div>
                </div>
              </div>
              <div class="font-mono-tabular text-[13px] font-medium text-[var(--color-brand)] text-right shrink-0">
                17d to 13h
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-[var(--color-border)] flex items-center justify-between text-[12px]">
            <span class="font-mono-tabular text-[var(--color-text-muted)]">Harness: RangeMaster Cockpit</span>
            <a href={resolvePath('/works/rangemaster-cockpit')} class="text-[var(--color-brand)] font-medium hover:underline inline-flex items-center gap-1">
              <span>Inspect architecture</span>
              <span class="material-symbols-outlined !text-[15px]" aria-hidden="true">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- GROWTH JOURNEY PREVIEW BANNER -->
    <section class="mantra-panel p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="flex items-center gap-2.5">
          <Badge variant="brand" size="sm">Evolutionary trajectory</Badge>
          <span class="text-[12px] text-[var(--color-text-muted)] font-mono-tabular">4 eras (2021–2026)</span>
        </div>
        <h2 class="font-display text-2xl sm:text-3xl text-[var(--color-text-main)]">
          Five years across infrastructure audits, SOC tuning, QA leadership, and AI risk strategy
        </h2>
        <p class="text-[14px] text-[var(--color-text-secondary)] leading-relaxed">
          From automating cloud IAM audits at Simplify IT and tuning SIEM detections at Silensec Africa to leading platform verification and GRC risk strategy at CYBER RANGES.
        </p>
      </div>
      <a href={resolvePath('/journey')} class="hig-btn hig-btn-tinted shrink-0">
        <span>Inspect growth timeline</span>
        <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">timeline</span>
      </a>
    </section>

    <!-- FEATURED WORKS -->
    <section class="space-y-8">
      <div class="flex items-end justify-between border-b border-[var(--color-border)] pb-4">
        <div>
          <div class="font-mono-tabular text-[12px] text-[var(--color-brand)] mb-1">DOSSIER-TC // SYSTEMS & HARNESSES</div>
          <h2 class="font-display text-3xl sm:text-4xl text-[var(--color-text-main)]">
            Featured production works
          </h2>
          <p class="text-[14px] text-[var(--color-text-secondary)] mt-1">
            Verification harnesses, access governance engines, and cyber drill telemetry systems
          </p>
        </div>
        <a href={resolvePath('/works')} class="hidden sm:inline-flex hig-filter-pill">
          <span>All works ({allWorks.length})</span>
          <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredWorks.map((work, idx) => (
          <ProjectCard
            id={work.id}
            title={work.data.title}
            tagline={work.data.tagline}
            description={work.data.description}
            category={work.data.category}
            tags={work.data.tags}
            stats={work.data.stats}
            github={work.data.github}
            gitlab={work.data.gitlab}
            demo={work.data.demo}
            featured={work.data.featured}
            index={idx}
          />
        ))}
      </div>

      <div class="sm:hidden">
        <a href={resolvePath('/works')} class="hig-btn hig-btn-glass w-full">
          <span>View all works ({allWorks.length})</span>
        </a>
      </div>
    </section>

    <!-- LEARNING CURVES SHOWCASE (Unslop Pass 2 & 8: Removed decorative blur blob) -->
    <section class="mantra-panel p-6 sm:p-10 space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[var(--color-border)] pb-4">
        <div class="max-w-2xl">
          <div class="font-mono-tabular text-[12px] text-[var(--color-brand)] mb-1">LC // DIAGNOSTIC LEDGER</div>
          <h2 class="font-display text-3xl sm:text-4xl text-[var(--color-text-main)]">
            Learning curves & root-cause post-mortems
          </h2>
          <p class="text-[14px] text-[var(--color-text-secondary)] mt-1.5 leading-relaxed">
            Behind every stable release is a trail of false hypotheses, OpenStack lock contentions, and wire contract drifts. These field notes document the exact diagnostic turning points.
          </p>
        </div>
        <a href={resolvePath('/learning-curves')} class="hig-filter-pill self-start md:self-auto shrink-0">
          <span>Browse all curves ({allLearnings.length})</span>
          <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {recentLearnings.map((item, idx) => (
          <LearningCard
            id={item.id}
            title={item.data.title}
            subtitle={item.data.subtitle}
            topic={item.data.topic}
            curveLevel={item.data.curveLevel}
            obstacle={item.data.obstacle}
            breakthrough={item.data.breakthrough}
            takeaways={item.data.takeaways}
            tags={item.data.tags}
            date={item.data.date}
            index={idx}
          />
        ))}
      </div>
    </section>

    <!-- RECENT ARTICLES -->
    <section class="space-y-8">
      <div class="flex items-end justify-between border-b border-[var(--color-border)] pb-4">
        <div>
          <div class="font-mono-tabular text-[12px] text-[var(--color-brand)] mb-1">ESSAY // TECHNICAL WRITING</div>
          <h2 class="font-display text-3xl sm:text-4xl text-[var(--color-text-main)]">
            Recent articles & essays
          </h2>
          <p class="text-[14px] text-[var(--color-text-secondary)] mt-1">
            Continuous dispatches on systems architecture, verification methodology, and engineering craft
          </p>
        </div>
        <a href={resolvePath('/blog')} class="hidden sm:inline-flex hig-filter-pill">
          <span>All articles ({allPosts.length})</span>
          <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post, idx) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            readTime={post.data.readTime}
            index={idx}
          />
        ))}
      </div>
    </section>

    <!-- CALL TO ACTION / CONNECT -->
    <section class="mantra-panel p-8 sm:p-12 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <div class="font-mono-tabular text-[12px] text-[var(--color-brand)]">DOSSIER-TC // CORRESPONDENCE</div>
        <h3 class="font-display text-2xl sm:text-3xl text-[var(--color-text-main)]">
          Exchange field notes on verification, access governance, or systems risk
        </h3>
        <p class="text-[14px] text-[var(--color-text-secondary)] leading-relaxed">
          Reach out directly for architectural discussions, quality engineering leadership, or security research collaboration.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a href="mailto:thaddeusmwai.9974@gmail.com" class="hig-btn hig-btn-primary">
          <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">mail</span>
          <span>Email Thaddeus</span>
        </a>
        <a href={resolvePath('/about')} class="hig-btn hig-btn-glass">
          <span>Executive dossier & bio</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
