---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import milestonesData from '../content/journey/milestones.json';
import { getCollection } from 'astro:content';
import { resolvePath } from '../utils/paths';

const allWorks = await getCollection('works');
const allLearnings = await getCollection('learnings');

// Map linked IDs to actual entries
const milestones = milestonesData.map((m) => {
  const linkedWorks = allWorks.filter((w) => m.linkedWorks.includes(w.id));
  const linkedLearnings = allLearnings.filter((l) => m.linkedLearnings.includes(l.id));
  return { ...m, resolvedWorks: linkedWorks, resolvedLearnings: linkedLearnings };
});

const levelBadge = {
  Pioneering: 'brand',
  Advanced: 'success',
  Proficient: 'warning',
  Intermediate: 'subtle',
} as const;
---

<Layout
  title="Growth Journey: Day 1 to Present | Thaddeus W. Mwai (aka Ted)"
  description="A chronological and topical retrospective showing continuous engineering evolution, mental model breakthroughs, and domain mastery from day 1 to the present."
>
  <div class="site-container space-y-12">
    <!-- Header -->
    <header class="max-w-3xl space-y-3">
      <div class="font-mono-tabular text-[12px] text-[var(--color-brand)]">DOSSIER-TC // EVOLUTIONARY RETROSPECTIVE</div>
      <h1 class="font-display text-4xl sm:text-5xl text-[var(--color-text-main)]">
        Growth journey: day 1 to present
      </h1>
      <p class="text-[16px] text-[var(--color-text-secondary)] leading-relaxed">
        Engineering judgment is forged through challenging production bottlenecks, false hypotheses, and architectural iterations. This ledger pairs <strong class="text-[var(--color-text-main)] font-medium">time in industry</strong> with <strong class="text-[var(--color-text-main)] font-medium">topical domain mastery</strong>.
      </p>

      <!-- High-level Metric Strip (Tabular figures, sentence-case labels) -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4">
        <div class="mantra-card p-4">
          <div class="font-mono-tabular text-2xl font-medium text-[var(--color-text-main)]">5+ years</div>
          <div class="text-[12px] text-[var(--color-text-muted)] mt-1">Continuous industry growth</div>
        </div>
        <div class="mantra-card p-4">
          <div class="font-mono-tabular text-2xl font-medium text-[var(--color-brand)]">4 eras</div>
          <div class="text-[12px] text-[var(--color-text-muted)] mt-1">Evolutionary milestones</div>
        </div>
        <div class="mantra-card p-4">
          <div class="font-mono-tabular text-2xl font-medium text-[var(--color-text-main)]">12+ domains</div>
          <div class="text-[12px] text-[var(--color-text-muted)] mt-1">Topical mastery verified</div>
        </div>
        <div class="mantra-card p-4">
          <div class="font-mono-tabular text-2xl font-medium text-[var(--color-positive)]">50+ tenancies</div>
          <div class="text-[12px] text-[var(--color-text-muted)] mt-1">Production verification scope</div>
        </div>
      </div>
    </header>

    <!-- Timeline Journey -->
    <section class="relative">
      <!-- Vertical Connecting Line on desktop -->
      <div class="hidden md:block absolute left-8 top-10 bottom-10 w-px bg-[var(--color-border)]"></div>

      <div class="space-y-10">
        {milestones.map((m, idx) => (
          <div class="relative md:pl-20">
            <!-- Timeline Marker Dot -->
            <div class="hidden md:flex absolute left-8 top-8 -translate-x-1/2 w-5 h-5 rounded-full border-2 border-[var(--color-brand)] bg-[var(--color-bg-card-solid)] items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)]"></div>
            </div>

            <!-- Milestone Card -->
            <article class="mantra-panel p-6 sm:p-8">
              <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
                <!-- Left Column: Era, Title, Summary & Turning Point -->
                <div class="xl:col-span-5 space-y-6">
                  <!-- Header Bar with Time & Era -->
                  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-border)] pb-4">
                    <div class="flex flex-wrap items-center gap-2">
                      <Badge variant="brand" size="md">{m.era}</Badge>
                      <Badge variant="subtle" size="md">{m.timeInIndustry}</Badge>
                      <span class="text-[12px] text-[var(--color-text-muted)] font-mono-tabular">{m.period}</span>
                    </div>
                    <div class="font-mono-tabular text-[11px] text-[var(--color-text-muted)]">
                      ERA // 0{idx + 1}
                    </div>
                  </div>

                  <!-- Main Title & Summary -->
                  <div>
                    <h2 class="font-display text-2xl sm:text-[26px] text-[var(--color-text-main)] leading-snug">
                      {m.title}
                    </h2>
                    <p class="mt-2 text-[14px] text-[var(--color-text-secondary)] leading-relaxed">
                      {m.summary}
                    </p>
                  </div>

                  <!-- Turning Point Breakthrough Box -->
                  <div class="rounded-[12px] border border-[var(--color-cr-border)] bg-[var(--color-cr-surface)] p-4">
                    <div class="text-[12px] font-medium text-[var(--color-positive)] mb-1.5 flex items-center gap-1.5">
                      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">check_circle</span>
                      <span>Diagnostic turning point</span>
                    </div>
                    <p class="text-[13px] text-[var(--color-text-main)] leading-relaxed">
                      {m.turningPoint}
                    </p>
                  </div>
                </div>

                <!-- Right Column: Topical Mastery, Evidence Artifacts, Skills -->
                <div class="xl:col-span-7 space-y-6 xl:border-l xl:border-[var(--color-border)] xl:pl-8">
                  <!-- Topical Mastery Grid -->
                  <div class="space-y-3">
                    <h3 class="text-[12px] font-mono-tabular text-[var(--color-text-muted)]">
                      Topical mastery acquired
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      {m.topicalMastery.map((tm) => (
                        <div class="rounded-[10px] border border-[var(--color-border)] bg-[var(--color-bg-card-solid)]/60 p-4 space-y-1.5">
                          <div class="flex items-center justify-between gap-2">
                            <span class="text-[13px] font-medium text-[var(--color-text-main)]">{tm.topic}</span>
                            <Badge variant={levelBadge[tm.level as keyof typeof levelBadge] || 'subtle'} size="sm">
                              {tm.level}
                            </Badge>
                          </div>
                          <p class="text-[12px] text-[var(--color-text-secondary)] leading-relaxed">
                            {tm.description}
                          </p>
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- Direct Evidence: Linked Works & Learning Curves -->
                  {(m.resolvedWorks.length > 0 || m.resolvedLearnings.length > 0) && (
                    <div class="pt-4 border-t border-[var(--color-border)] space-y-3">
                      <div class="text-[12px] font-mono-tabular text-[var(--color-text-muted)]">
                        Direct evidence & production artifacts from this era
                      </div>
                      <div class="flex flex-wrap gap-2">
                        {m.resolvedWorks.map((w) => (
                          <a
                            href={resolvePath(`/works/${w.id}`)}
                            class="hig-filter-pill !border-[var(--color-border-accent)]"
                          >
                            <span class="material-symbols-outlined !text-[15px] text-[var(--color-brand)]" aria-hidden="true">deployed_code</span>
                            <span>Work: {w.data.title}</span>
                          </a>
                        ))}
                        {m.resolvedLearnings.map((l) => (
                          <a
                            href={resolvePath(`/learning-curves/${l.id}`)}
                            class="hig-filter-pill"
                          >
                            <span class="material-symbols-outlined !text-[15px] text-[var(--color-positive)]" aria-hidden="true">troubleshoot</span>
                            <span>Curve: {l.data.title}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  <!-- Skills tags -->
                  <div class="flex flex-wrap gap-1.5 pt-2">
                    {m.skills.map((skill) => (
                      <Badge variant="subtle" size="sm">{skill}</Badge>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Callout -->
    <section class="mantra-panel p-8 text-center space-y-3">
      <div class="font-mono-tabular text-[12px] text-[var(--color-brand)]">DOSSIER-TC // CONTINUOUS LEDGER</div>
      <h3 class="font-display text-2xl sm:text-3xl text-[var(--color-text-main)]">
        The trajectory is continuously documented
      </h3>
      <p class="text-[14px] text-[var(--color-text-secondary)] max-w-xl mx-auto leading-relaxed">
        Whenever I diagnose a new distributed systems deadlock, wire contract mismatch, or access governance vulnerability, I record the root cause and remediation here.
      </p>
      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a href={resolvePath('/learning-curves')} class="hig-btn hig-btn-primary">
          <span>Explore learning curves</span>
          <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_forward</span>
        </a>
        <a href={resolvePath('/works')} class="hig-btn hig-btn-glass">
          <span>Browse production works</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
