---
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/Badge.astro';
import DomainBadge from '../../components/DomainBadge.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import SyndicationBar from '../../components/SyndicationBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
}).format(entry.data.date);
---

<Layout
  title={`${entry.data.title} | Case Study`}
  description={entry.data.description}
  showReadingProgress={true}
>
  <article class="site-container-reading space-y-8">
    <!-- Back breadcrumb -->
    <div>
      <a href="/works" class="hig-filter-pill">
        <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_back</span>
        <span>All works</span>
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="space-y-4 border-b border-[var(--color-border)] pb-8">
      <div class="flex flex-wrap items-center gap-2.5">
        <DomainBadge label={entry.data.category} id={entry.id} showCode={true} />
        <span class="text-[12px] text-[var(--color-text-muted)] font-mono-tabular">{formattedDate}</span>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl text-[var(--color-text-main)] leading-[1.12] max-w-4xl">
        {entry.data.title}
      </h1>

      <p class="text-[17px] text-[var(--color-text-secondary)] leading-relaxed max-w-3xl">
        {entry.data.tagline}
      </p>

      <!-- Action buttons (Apple HIG 44px Capsule Buttons, equal height) -->
      {(entry.data.demo || entry.data.github) && (
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {entry.data.demo && (
            <a
              href={entry.data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="hig-btn hig-btn-primary"
            >
              <span>Open live reference</span>
              <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">open_in_new</span>
            </a>
          )}

          {entry.data.github && (
            <a
              href={entry.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="hig-btn hig-btn-glass"
            >
              <BrandIcon name="github" class="w-4 h-4" />
              <span>GitHub repository</span>
            </a>
          )}
        </div>
      )}

      <!-- Stats highlight (Tabular figures, sentence-case labels) -->
      {entry.data.stats && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4">
          {entry.data.stats.map((s) => (
            <div class="mantra-card p-4">
              <div class="font-mono-tabular text-xl sm:text-2xl font-medium text-[var(--color-brand)]">{s.value}</div>
              <div class="text-[12px] text-[var(--color-text-secondary)] mt-1">{s.label}</div>
            </div>
          ))}
        </div>
      )}

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-2">
        {entry.data.tags.map((tag) => (
          <Badge variant="subtle" size="md">{tag}</Badge>
        ))}
      </div>
    </header>

    <!-- Main Markdown Content + Sticky Table of Contents -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8 space-y-8">
        <div class="mantra-card p-6 sm:p-10 prose-content">
          <Content />
        </div>

        <SyndicationBar
          title={entry.data.title}
          description={entry.data.tagline}
          tags={entry.data.tags}
          type="case-study"
        />

        <!-- Footer navigation -->
        <div class="pt-4 flex flex-wrap items-center justify-between gap-4">
          <a href="/works" class="hig-btn hig-btn-glass">
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_back</span>
            <span>Back to all works</span>
          </a>
          <a href="/learning-curves" class="hig-btn hig-btn-tinted">
            <span>Read related learning curves</span>
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-4">
        <TableOfContents headings={headings} stamp="DOC-CR // TOC" />
      </div>
    </div>
  </article>
</Layout>
