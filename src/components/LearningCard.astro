---
import Badge from './Badge.astro';
import DomainBadge from './DomainBadge.astro';
import { resolvePath } from '../utils/paths';

interface Props {
  id: string;
  title: string;
  subtitle: string;
  topic: string;
  curveLevel: 'Steep' | 'Moderate' | 'Smooth';
  obstacle: string;
  breakthrough: string;
  takeaways: string[];
  tags: string[];
  date: Date;
  index?: number;
}

const { id, title, subtitle, topic, curveLevel, obstacle, breakthrough, tags, date, index } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(date);

const levelVariant = {
  Steep: 'danger',
  Moderate: 'warning',
  Smooth: 'success',
}[curveLevel] as 'danger' | 'warning' | 'success';

const stampIndex = typeof index === 'number' ? String(index + 1).padStart(2, '0') : id.slice(0, 2).toUpperCase();
---

<article class="mantra-card group relative flex flex-col justify-between p-6">
  <div>
    <!-- Top metadata row -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-2">
        <DomainBadge label={topic} id={id} />
        <Badge variant={levelVariant} size="sm">
          {curveLevel} curve
        </Badge>
      </div>
      <div class="flex items-center gap-2 font-mono-tabular text-[11px] text-[var(--color-text-muted)]">
        <span>LC // {stampIndex}</span>
        <span>·</span>
        <time>{formattedDate}</time>
      </div>
    </div>

    <!-- Title & Subtitle (Newsreader editorial serif) -->
    <h3 class="font-display text-xl sm:text-[22px] leading-snug text-[var(--color-text-main)] group-hover:text-[var(--color-brand)] transition-colors">
      <a href={resolvePath(`/learning-curves/${id}`)}>
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <p class="text-[13px] leading-5 text-[var(--color-text-secondary)] mt-1">
      {subtitle}
    </p>

    <!-- Problem vs Solution Breakdown (Nested radius: 16px card - 8px pad = 8px inner radius) -->
    <div class="mt-4 space-y-2 text-[13px]">
      <div class="rounded-[8px] bg-[var(--color-bg-subtle)] border border-[var(--color-border)] p-3">
        <div class="font-medium text-[var(--color-negative)] flex items-center gap-1.5 mb-1">
          <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">error</span>
          <span>Obstacle encountered</span>
        </div>
        <p class="text-[var(--color-text-secondary)] leading-relaxed">
          {obstacle}
        </p>
      </div>

      <div class="rounded-[8px] bg-[var(--color-cr-surface)] border border-[var(--color-cr-border)] p-3">
        <div class="font-medium text-[var(--color-positive)] flex items-center gap-1.5 mb-1">
          <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">check_circle</span>
          <span>Diagnostic breakthrough</span>
        </div>
        <p class="text-[var(--color-text-secondary)] leading-relaxed">
          {breakthrough}
        </p>
      </div>
    </div>
  </div>

  <!-- Footer with tags & link -->
  <div class="mt-4 pt-3 border-t border-[var(--color-border)] flex flex-wrap items-center justify-between gap-3 text-[13px]">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <Badge variant="subtle" size="sm">{tag}</Badge>
      ))}
    </div>

    <span class="text-[var(--color-brand)] font-medium inline-flex items-center gap-1.5">
      <span>Read field notes</span>
      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_forward</span>
    </span>
  </div>
</article>
