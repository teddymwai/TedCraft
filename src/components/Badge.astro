---
interface Props {
  variant?: 'brand' | 'subtle' | 'warning' | 'success' | 'danger';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'subtle', size = 'sm', class: className = '' } = Astro.props;

const variantStyles = {
  brand: 'bg-[var(--color-accent-badge)] text-[var(--color-brand)] border-[var(--color-brand)]/20',
  subtle: 'bg-[var(--color-bg-subtle)] text-[var(--color-text-muted)] border-[var(--color-border)]',
  warning: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
  success: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
  danger: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20',
};

const sizeStyles = {
  sm: 'text-[11px] px-2 py-0.5 rounded-full',
  md: 'text-xs px-2.5 py-1 rounded-md',
};
---

<span class={`inline-flex items-center font-medium border ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}>
  <slot />
</span>
