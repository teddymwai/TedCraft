---
interface Props {
  variant?: 'brand' | 'subtle' | 'warning' | 'success' | 'danger';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'subtle', size = 'sm', class: className = '' } = Astro.props;

const variantStyles = {
  brand: 'bg-[var(--color-accent-badge)] text-[var(--color-brand)] border-[var(--color-border-accent)]',
  subtle: 'bg-[var(--color-bg-subtle)] text-[var(--color-text-secondary)] border-[var(--color-border)]',
  warning: 'bg-[var(--color-accent-badge)] text-[var(--color-brand)] border-[var(--color-border-accent)]',
  success: 'bg-[var(--color-cr-surface)] text-[var(--color-positive)] border-[var(--color-cr-border)]',
  danger: 'bg-[var(--color-negative)]/10 text-[var(--color-negative)] border-[var(--color-negative)]/25',
};

const sizeStyles = {
  sm: 'text-[12px] leading-4 px-2 py-0.5 rounded-[6px]',
  md: 'text-[12px] leading-4 px-2.5 py-1 rounded-[8px]',
};
---

<span class={`inline-flex items-center font-normal border ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}>
  <slot />
</span>
