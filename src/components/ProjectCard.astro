---
import Badge from './Badge.astro';
import DomainBadge from './DomainBadge.astro';
import BrandIcon from './BrandIcon.astro';
import { resolvePath } from '../utils/paths';

interface Props {
  id: string;
  title: string;
  tagline: string;
  description: string;
  category: string;
  tags: string[];
  stats?: { label: string; value: string }[];
  github?: string;
  gitlab?: string;
  demo?: string;
  featured?: boolean;
  index?: number;
}

const { id, title, tagline, description, category, tags, stats, github, gitlab, demo, featured, index } = Astro.props;
const stampIndex = typeof index === 'number' ? String(index + 1).padStart(2, '0') : id.slice(0, 2).toUpperCase();
const repoUrl = gitlab || github;
const isGitLab = Boolean(gitlab || (github && github.includes('gitlab.com')));
---

<article class={`mantra-card group relative flex flex-col justify-between p-6 ${featured ? 'border-[var(--color-border-accent)]' : ''}`}>
  <div>
    <!-- Header with DomainBadge and Dossier Signature Stamp -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <DomainBadge label={category} id={id} />
      <span class="font-mono-tabular text-[11px] text-[var(--color-text-muted)]">
        TC // {stampIndex}
      </span>
    </div>

    <!-- Title and tagline (Newsreader Editorial Serif, weight 500) -->
    <h3 class="font-display text-xl sm:text-[22px] leading-snug text-[var(--color-text-main)] group-hover:text-[var(--color-brand)] transition-colors">
      <a href={resolvePath(`/works/${id}`)}>
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <p class="text-[13px] leading-5 font-medium text-[var(--color-brand)] mt-1">
      {tagline}
    </p>

    <!-- Description -->
    <p class="mt-3 text-[14px] text-[var(--color-text-secondary)] line-clamp-3 leading-relaxed">
      {description}
    </p>

    <!-- Project Metrics (Unslop Pass 5 & 7: Tabular figures, sentence-case labels) -->
    {stats && stats.length > 0 && (
      <div class="mt-4 grid grid-cols-3 gap-2 border-y border-[var(--color-border)] py-3 my-4">
        {stats.map((stat) => (
          <div>
            <div class="font-mono-tabular text-[13px] font-medium text-[var(--color-text-main)]">{stat.value}</div>
            <div class="text-[11px] text-[var(--color-text-muted)] mt-0.5">{stat.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="mt-4 pt-3 border-t border-[var(--color-border)]">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {tags.slice(0, 4).map((tag) => (
        <Badge variant="subtle" size="sm">{tag}</Badge>
      ))}
      {tags.length > 4 && (
        <span class="font-mono-tabular text-[11px] text-[var(--color-text-muted)] self-center">+{tags.length - 4}</span>
      )}
    </div>

    <!-- Action Links -->
    <div class="flex items-center justify-between text-[13px] font-medium relative z-10 pt-1">
      <span class="text-[var(--color-brand)] inline-flex items-center gap-1.5">
        <span>Read case study</span>
        <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_forward</span>
      </span>

      <div class="flex items-center gap-3">
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] transition-colors inline-flex items-center"
            title={isGitLab ? "View source on GitLab" : "View source on GitHub"}
            aria-label={isGitLab ? "View source on GitLab" : "View source on GitHub"}
          >
            <BrandIcon name={isGitLab ? "gitlab" : "github"} class="w-4 h-4" />
          </a>
        )}
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] transition-colors"
            title="Open live reference"
          >
            <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">open_in_new</span>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
