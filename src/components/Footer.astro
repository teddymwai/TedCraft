---
import BrandIcon from './BrandIcon.astro';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/teddymwai',
    ariaLabel: 'Teddy Mwai on GitHub',
    brandIcon: 'github' as const,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/teddymwai/',
    ariaLabel: 'Thaddeus Mwai on LinkedIn',
    brandIcon: 'linkedin' as const,
  },
  {
    name: 'GitLab',
    href: 'https://gitlab.com/teddymwai',
    ariaLabel: 'Teddy Mwai on GitLab',
    brandIcon: 'gitlab' as const,
  },
  {
    name: 'Email',
    href: 'mailto:thaddeusmwai.9974@gmail.com',
    ariaLabel: 'Send email to Thaddeus Mwai',
    materialIcon: 'mail',
  },
  {
    name: 'RSS',
    href: '/rss.xml',
    ariaLabel: 'Subscribe via RSS',
    materialIcon: 'rss_feed',
  },
];

const quickLinks = [
  { label: 'Overview', href: '/' },
  { label: 'Growth journey', href: '/journey' },
  { label: 'Works', href: '/works' },
  { label: 'Learning curves', href: '/learning-curves' },
  { label: 'Articles', href: '/blog' },
  { label: 'About', href: '/about' },
];
---

<footer class="mt-auto border-t border-[var(--color-border)] bg-[var(--color-bg-card)] backdrop-blur-md py-12">
  <div class="site-container space-y-8">
    <!-- Top Row: Brand & Social Capsule Links -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-md">
        <div class="flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-[6px] bg-[var(--color-bg-subtle)] border border-[var(--color-border-accent)] text-[var(--color-brand)] font-display font-medium flex items-center justify-center text-[10px] tracking-tight">
            TC
          </span>
          <span class="font-medium text-[15px] text-[var(--color-text-main)]">
            Thaddeus (Ted) Mwai
          </span>
          <span class="text-[11px] font-mono-tabular text-[var(--color-brand)] bg-[var(--color-accent-badge)] px-2 py-0.5 rounded-[6px] border border-[var(--color-border-accent)]">
            CYBER RANGES
          </span>
        </div>
        <p class="text-[13px] leading-5 text-[var(--color-text-secondary)]">
          Security QA Lead and Risk Strategist. Documenting high-assurance platform verification, access governance, and engineering post-mortems.
        </p>
      </div>

      <!-- Social Capsule Controls with Official Brand SVG Icons -->
      <div class="flex flex-wrap items-center gap-2">
        {socialLinks.map((item) => (
          <a
            href={item.href}
            target={item.href.startsWith('mailto') || item.href.startsWith('/') ? undefined : '_blank'}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={item.ariaLabel}
            class="hig-filter-pill"
          >
            {item.brandIcon ? (
              <BrandIcon name={item.brandIcon} class="w-4 h-4 text-[var(--color-text-muted)]" />
            ) : (
              <span class="material-symbols-outlined !text-[16px] text-[var(--color-text-muted)]" aria-hidden="true">
                {item.materialIcon}
              </span>
            )}
            <span>{item.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Middle Row: Navigation Links -->
    <div class="pt-6 border-t border-[var(--color-border)] flex flex-wrap items-center justify-between gap-4 text-[13px] text-[var(--color-text-secondary)]">
      <nav class="flex flex-wrap items-center gap-6" aria-label="Footer navigation">
        {quickLinks.map((link) => (
          <a href={link.href} class="hover:text-[var(--color-brand)] transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="text-[12px] font-mono-tabular text-[var(--color-text-muted)]">
        Stafford, VA // Nairobi, Kenya
      </div>
    </div>

    <!-- Bottom Row: Copyright & Credits -->
    <div class="pt-4 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-center justify-between gap-2 text-[12px] text-[var(--color-text-muted)]">
      <div>
        Copyright {currentYear} Thaddeus (Ted) Mwai
      </div>
      <div class="font-mono-tabular">
        DOC-CR // TedCraft Engineering Dossier & UI Mantra Architecture
      </div>
    </div>
  </div>
</footer>
