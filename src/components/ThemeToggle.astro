---
// ThemeToggle.astro - Apple HIG 44x44px Circular Button + modern-web-guidance color-scheme
---

<div class="relative inline-flex items-center">
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Toggle color theme"
    class="hig-btn hig-btn-glass !p-0 w-11 h-11 rounded-full text-[var(--color-text-secondary)] hover:text-[var(--color-brand)]"
  >
    <!-- Sun icon (shown when dark -> switch to light parchment mode) -->
    <span id="theme-icon-sun" class="material-symbols-outlined hidden" aria-hidden="true">
      light_mode
    </span>

    <!-- Moon icon (shown when light -> switch to dark obsidian mode) -->
    <span id="theme-icon-moon" class="material-symbols-outlined hidden" aria-hidden="true">
      dark_mode
    </span>
  </button>
</div>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const metaTheme = document.querySelector('meta[name="color-scheme"]');

    if (!btn || !metaTheme || !sunIcon || !moonIcon) return;

    function getResolvedTheme() {
      const stored = localStorage.getItem('color-scheme');
      if (stored === 'light' || stored === 'dark') return stored;
      const metaVal = metaTheme?.getAttribute('content');
      if (metaVal === 'light' || metaVal === 'dark') return metaVal;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function updateIcons() {
      if (!btn || !sunIcon || !moonIcon) return;
      const current = getResolvedTheme();
      if (current === 'dark') {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
        btn.setAttribute('aria-label', 'Switch to light reading theme');
        btn.setAttribute('title', 'Switch to Warm Ivory reading theme');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
        btn.setAttribute('aria-label', 'Switch to dark obsidian theme');
        btn.setAttribute('title', 'Switch to Deep Obsidian theme');
      }
    }

    btn.addEventListener('click', () => {
      const current = getResolvedTheme();
      const next = current === 'dark' ? 'light' : 'dark';
      localStorage.setItem('color-scheme', next);
      metaTheme.setAttribute('content', next);
      updateIcons();
    });

    // Listen to OS system preference changes when no explicit override exists
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('color-scheme')) {
        metaTheme.setAttribute('content', e.matches ? 'dark' : 'light');
        updateIcons();
      }
    });

    // Sync across browser tabs
    window.addEventListener('storage', (e) => {
      if (e.key === 'color-scheme') {
        metaTheme.setAttribute('content', e.newValue || 'dark');
        updateIcons();
      }
    });

    updateIcons();
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
