---
// ThemeToggle.astro - Compliant with modern-web-guidance
---

<div class="relative inline-flex items-center">
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Toggle color theme"
    class="p-2 rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-brand)] hover:bg-[var(--color-bg-subtle)] transition-colors cursor-pointer border border-[var(--color-border)]"
  >
    <!-- Sun icon (shown when dark or toggling to light) -->
    <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>

    <!-- Moon icon (shown when light or toggling to dark) -->
    <svg id="theme-icon-moon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>
</div>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const metaTheme = document.querySelector('meta[name="color-scheme"]');

    if (!btn || !metaTheme || !sunIcon || !moonIcon) return;

    function getResolvedTheme() {
      const stored = localStorage.getItem('color-scheme');
      if (stored === 'light' || stored === 'dark') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function updateIcons() {
      const current = getResolvedTheme();
      if (current === 'dark') {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
        btn.setAttribute('aria-label', 'Switch to light theme');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
        btn.setAttribute('aria-label', 'Switch to dark theme');
      }
    }

    btn.addEventListener('click', () => {
      const current = getResolvedTheme();
      const next = current === 'dark' ? 'light' : 'dark';
      const systemPreference = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

      if (next === systemPreference) {
        localStorage.removeItem('color-scheme');
        metaTheme.setAttribute('content', 'light dark');
      } else {
        localStorage.setItem('color-scheme', next);
        metaTheme.setAttribute('content', next);
      }
      updateIcons();
    });

    // Listen to OS system preference changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!localStorage.getItem('color-scheme')) {
        updateIcons();
      }
    });

    // Sync across browser tabs
    window.addEventListener('storage', (e) => {
      if (e.key === 'color-scheme') {
        metaTheme.setAttribute('content', e.newValue || 'light dark');
        updateIcons();
      }
    });

    updateIcons();
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>
