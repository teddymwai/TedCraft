---
// AmbientCanvas.astro — Antigravity-inspired breathing radial capsule-ring canvas
// Adapted to TedCraft's Champagne Gold / Bronze-Gold palette and Quiet Chrome rules.
---

<canvas id="ambient-canvas" aria-hidden="true"></canvas>

<script>
  interface Capsule {
    hx: number;
    hy: number;
    x: number;
    y: number;
    scale: number;
    seed: number;
  }

  interface AmbientController {
    destroy: () => void;
  }

  const CELL_SIZE = 44;
  const MAX_CAPSULES = 900;
  const CAPSULE_LEN = 7.5;
  const CAPSULE_WID = 2.6;
  const RING_LERP = 0.045;
  const SCALE_LERP = 0.16;
  const FRAME_INTERVAL_MS = 1000 / 30;

  let ambientInstance: AmbientController | null = null;
  let lifecycleRegistered = false;

  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const coarsePointerQuery = window.matchMedia('(pointer: coarse)');
  const darkSchemeQuery = window.matchMedia('(prefers-color-scheme: dark)');

  function isEligible(): boolean {
    if (reducedMotionQuery.matches || coarsePointerQuery.matches) return false;
    const el = document.getElementById('ambient-canvas');
    return el instanceof HTMLCanvasElement;
  }

  function smoothstep(edge0: number, edge1: number, x: number): number {
    const t = Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
    return t * t * (3 - 2 * t);
  }

  function createAmbientCanvas(canvas: HTMLCanvasElement): AmbientController | null {
    const rawCtx = canvas.getContext('2d');
    if (!rawCtx) return null;
    const ctx: CanvasRenderingContext2D = rawCtx;

    let destroyed = false;
    let rafId: number | null = null;
    let width = window.innerWidth;
    let height = window.innerHeight;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);

    let pointerX = width * 0.5;
    let pointerY = height * 0.42;
    let pointerActive = false;

    let ringX = pointerX;
    let ringY = pointerY;

    let cachedRgb = '212, 168, 83';
    let isDarkTheme = true;

    let elapsed = 0;
    let lastTime = performance.now();
    let lastDrawTime = 0;

    let capsules: Capsule[] = [];

    function buildCapsules(w: number, h: number): Capsule[] {
      const cols = Math.max(8, Math.ceil(w / CELL_SIZE));
      const rows = Math.max(6, Math.ceil(h / CELL_SIZE));
      const stepX = w / cols;
      const stepY = h / rows;
      const list: Capsule[] = [];

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (list.length >= MAX_CAPSULES) break;
          const hx = (c + 0.2 + Math.random() * 0.6) * stepX;
          const hy = (r + 0.2 + Math.random() * 0.6) * stepY;
          list.push({
            hx,
            hy,
            x: hx,
            y: hy,
            scale: 0,
            seed: Math.random() * Math.PI * 2,
          });
        }
      }
      return list;
    }

    function syncThemeColor(): void {
      const computed = getComputedStyle(canvas).color;
      const match = computed.match(/\d+/g);
      if (match && match.length >= 3) {
        cachedRgb = `${match[0]}, ${match[1]}, ${match[2]}`;
      }
      const metaContent = document
        .querySelector('meta[name="color-scheme"]')
        ?.getAttribute('content');
      if (metaContent === 'light' || metaContent === 'dark') {
        isDarkTheme = metaContent === 'dark';
      } else {
        isDarkTheme = darkSchemeQuery.matches;
      }
    }

    function resizeCanvas(): void {
      const prevW = width || 1;
      const prevH = height || 1;
      const nextW = window.innerWidth;
      const nextH = window.innerHeight;
      const nextDpr = Math.min(window.devicePixelRatio || 1, 2);

      if (nextW === prevW && nextH === prevH && nextDpr === dpr && canvas.width > 0) {
        return;
      }

      if (capsules.length === 0) {
        capsules = buildCapsules(nextW, nextH);
      } else {
        const scaleX = nextW / prevW;
        const scaleY = nextH / prevH;
        for (let i = 0; i < capsules.length; i++) {
          capsules[i].hx *= scaleX;
          capsules[i].hy *= scaleY;
          capsules[i].x *= scaleX;
          capsules[i].y *= scaleY;
        }
      }

      ringX *= nextW / prevW;
      ringY *= nextH / prevH;

      width = nextW;
      height = nextH;
      dpr = nextDpr;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function stepAndDraw(now: number): void {
      if (destroyed || document.hidden) {
        rafId = null;
        return;
      }

      rafId = requestAnimationFrame(stepAndDraw);

      if (now - lastDrawTime < FRAME_INTERVAL_MS) return;
      lastDrawTime = now;

      const dt = Math.min(Math.max((now - lastTime) / 1000, 0.001), 0.05);
      lastTime = now;
      elapsed += dt;

      // Lazy magnetic lag toward cursor + gentle figure-eight idle drift
      const idleOffsetX = Math.sin(elapsed * 0.55) * 28;
      const idleOffsetY = Math.cos(elapsed * 0.42) * 18;
      const targetX = pointerActive ? pointerX + idleOffsetX * 0.25 : width * 0.5 + idleOffsetX;
      const targetY = pointerActive ? pointerY + idleOffsetY * 0.25 : height * 0.42 + idleOffsetY;

      const lagFactor = 1 - Math.pow(1 - RING_LERP, dt * 60);
      ringX += (targetX - ringX) * lagFactor;
      ringY += (targetY - ringY) * lagFactor;

      // Breathing ring radius (~22% of min viewport dimension)
      const baseRing = Math.min(width, height) * 0.22;
      const ringRadius =
        baseRing + Math.sin(elapsed * 1.1) * 16 + Math.cos(elapsed * 2.7) * 8;
      const bandWidth = Math.max(70, baseRing * 0.58);

      ctx.clearRect(0, 0, width, height);

      const peakAlpha = isDarkTheme ? 0.34 : 0.24;
      const scaleEase = 1 - Math.pow(1 - SCALE_LERP, dt * 60);

      for (let i = 0; i < capsules.length; i++) {
        const p = capsules[i];

        // Subtle organic drift around home position
        const driftX = Math.sin(elapsed * 0.7 + p.seed) * 5;
        const driftY = Math.cos(elapsed * 0.6 + p.seed * 1.3) * 5;
        const baseX = p.hx + driftX;
        const baseY = p.hy + driftY;

        const dx = baseX - ringX;
        const dy = baseY - ringY;
        const dist = Math.hypot(dx, dy);

        // Ring band intensity + soft inner halo
        const ringDelta = Math.abs(dist - ringRadius);
        const band = 1 - smoothstep(0, bandWidth, ringDelta);
        const inner = (1 - smoothstep(0, ringRadius, dist)) * 0.32;
        const targetScale = Math.min(1, band + inner);

        p.scale += (targetScale - p.scale) * scaleEase;
        if (p.scale < 0.08) continue;

        // Radial lensing push outward along the ring band
        const push = Math.pow(band, 0.85) * 14;
        const invDist = dist > 0.001 ? 1 / dist : 0;
        const nx = dx * invDist;
        const ny = dy * invDist;

        p.x = baseX + nx * push;
        p.y = baseY + ny * push;

        // Orient capsule radially from ring center + subtle organic wiggle
        const angle =
          Math.atan2(p.y - ringY, p.x - ringX) + Math.sin(elapsed * 0.9 + p.seed) * 0.18;

        const len = CAPSULE_LEN * (0.45 + p.scale * 0.75);
        const wid = CAPSULE_WID * (0.55 + p.scale * 0.45);
        const alpha = (p.scale * peakAlpha).toFixed(3);

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(angle);
        ctx.fillStyle = `rgba(${cachedRgb}, ${alpha})`;
        ctx.beginPath();
        if (typeof ctx.roundRect === 'function') {
          ctx.roundRect(-len * 0.5, -wid * 0.5, len, wid, wid * 0.5);
        } else {
          ctx.rect(-len * 0.5, -wid * 0.5, len, wid);
        }
        ctx.fill();
        ctx.restore();
      }
    }

    function startLoop(): void {
      if (destroyed || document.hidden || rafId !== null) return;
      lastTime = performance.now();
      rafId = requestAnimationFrame(stepAndDraw);
    }

    function stopLoop(): void {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    function onPointerMove(e: PointerEvent): void {
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      pointerX = e.clientX;
      pointerY = e.clientY;
      pointerActive = true;
    }

    function clearPointer(): void {
      pointerActive = false;
    }

    function onVisibilityChange(): void {
      if (document.hidden) {
        stopLoop();
      } else {
        startLoop();
      }
    }

    const metaTheme = document.querySelector('meta[name="color-scheme"]');
    const themeObserver = new MutationObserver(() => {
      syncThemeColor();
    });
    if (metaTheme) {
      themeObserver.observe(metaTheme, {
        attributes: true,
        attributeFilter: ['content'],
      });
    }

    const onSystemThemeChange = () => syncThemeColor();

    capsules = buildCapsules(width, height);
    resizeCanvas();
    syncThemeColor();

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    document.addEventListener('pointerleave', clearPointer);
    window.addEventListener('blur', clearPointer);
    window.addEventListener('resize', resizeCanvas, { passive: true });
    document.addEventListener('visibilitychange', onVisibilityChange);
    darkSchemeQuery.addEventListener('change', onSystemThemeChange);

    startLoop();

    return {
      destroy() {
        if (destroyed) return;
        destroyed = true;
        stopLoop();
        themeObserver.disconnect();
        window.removeEventListener('pointermove', onPointerMove);
        document.removeEventListener('pointerleave', clearPointer);
        window.removeEventListener('blur', clearPointer);
        window.removeEventListener('resize', resizeCanvas);
        document.removeEventListener('visibilitychange', onVisibilityChange);
        darkSchemeQuery.removeEventListener('change', onSystemThemeChange);
        ctx.clearRect(0, 0, width, height);
      },
    };
  }

  function initializeAmbientCanvas(): void {
    if (ambientInstance || !isEligible()) return;
    const canvas = document.getElementById('ambient-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    ambientInstance = createAmbientCanvas(canvas);
  }

  function destroyAmbientCanvas(): void {
    ambientInstance?.destroy();
    ambientInstance = null;
  }

  function handleEligibilityChange(): void {
    if (isEligible()) {
      initializeAmbientCanvas();
    } else {
      destroyAmbientCanvas();
    }
  }

  if (!lifecycleRegistered) {
    lifecycleRegistered = true;
    document.addEventListener('astro:before-swap', destroyAmbientCanvas);
    document.addEventListener('astro:page-load', initializeAmbientCanvas);
    reducedMotionQuery.addEventListener('change', handleEligibilityChange);
    coarsePointerQuery.addEventListener('change', handleEligibilityChange);
  }

  initializeAmbientCanvas();
</script>
