---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Overview', href: '/' },
  { label: 'Growth journey', href: '/journey' },
  { label: 'Works', href: '/works' },
  { label: 'Learning curves', href: '/learning-curves' },
  { label: 'Articles', href: '/blog' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 h-16 backdrop-blur-md bg-[var(--color-bg-card)] border-b border-[var(--color-border)]">
  <div class="site-container flex items-center justify-between h-full">
    <a href="/" class="flex items-center gap-3 text-decoration-none group">
      <span class="w-8 h-8 rounded-[8px] bg-[var(--color-bg-subtle)] border border-[var(--color-border-accent)] text-[var(--color-brand)] font-display font-medium flex items-center justify-center text-sm tracking-tight">
        TC
      </span>
      <div class="flex flex-col">
        <span class="font-medium text-[15px] leading-5 text-[var(--color-text-main)] group-hover:text-[var(--color-brand)] transition-colors">
          Thaddeus Mwai
        </span>
        <span class="text-[12px] leading-4 text-[var(--color-text-muted)] font-mono-tabular hidden sm:inline">
          TedCraft // Dossier & Engineering Ledger
        </span>
      </div>
    </a>

    <!-- Desktop Navigation (Unslop Pass 1 & 7: 36px height rows, 4px gap, surface step active state) -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`relative h-9 px-3.5 rounded-[8px] inline-flex items-center text-[14px] leading-5 transition-colors ${
              isActive
                ? 'text-[var(--color-text-main)] bg-[var(--color-bg-subtle)] border border-[var(--color-border-accent)] font-medium shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-main)] hover:bg-[var(--color-bg-subtle)]/60 border border-transparent font-normal'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <a
        href="/rss.xml"
        class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3 rounded-[8px] text-[13px] text-[var(--color-text-muted)] hover:text-[var(--color-text-main)] transition-colors font-mono-tabular"
        title="RSS Feed"
      >
        <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">rss_feed</span>
        <span>RSS</span>
      </a>

      <ThemeToggle />

      <!-- Mobile menu button (Apple HIG 44x44px hit target) -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="md:hidden hig-btn hig-btn-glass !p-0 w-11 h-11 rounded-full text-[var(--color-text-secondary)]"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[var(--color-border)] bg-[var(--color-bg-card-solid)] px-4 py-3">
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`h-11 px-3 rounded-[8px] flex items-center text-[14px] transition-colors ${
              isActive
                ? 'text-[var(--color-brand)] bg-[var(--color-accent-badge)] border border-[var(--color-border-accent)] font-medium'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-main)] hover:bg-[var(--color-bg-subtle)] font-normal'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
