---
import Badge from './Badge.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  readTime: string;
}

const { id, title, description, pubDate, tags, readTime } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);
---

<article class="group relative rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 transition-all duration-200 hover:shadow-md hover:border-[var(--color-brand)]/50">
  <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] mb-2 font-mono">
    <time>{formattedDate}</time>
    <span>{readTime}</span>
  </div>

  <h3 class="text-lg font-bold text-[var(--color-text-main)] group-hover:text-[var(--color-brand)] transition-colors">
    <a href={`/blog/${id}`}>
      <span class="absolute inset-0 z-0"></span>
      {title}
    </a>
  </h3>

  <p class="mt-2 text-sm text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
    {description}
  </p>

  <div class="mt-4 flex items-center justify-between pt-3 border-t border-[var(--color-border)]/50 text-xs">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <Badge variant="subtle" size="sm">{tag}</Badge>
      ))}
    </div>

    <span class="text-[var(--color-brand)] font-semibold flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Read Article
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </span>
  </div>
</article>
