---
import Badge from './Badge.astro';
import { resolvePath } from '../utils/paths';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  readTime: string;
  index?: number;
}

const { id, title, description, pubDate, tags, readTime, index } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);

const stampIndex = typeof index === 'number' ? String(index + 1).padStart(2, '0') : id.slice(0, 2).toUpperCase();
---

<article class="mantra-card group relative flex flex-col justify-between p-6">
  <div>
    <div class="flex items-center justify-between text-[11px] text-[var(--color-text-muted)] mb-3 font-mono-tabular">
      <div class="flex items-center gap-2">
        <span>ESSAY // {stampIndex}</span>
        <span>·</span>
        <time>{formattedDate}</time>
      </div>
      <span>{readTime}</span>
    </div>

    <h3 class="font-display text-xl sm:text-[22px] leading-snug text-[var(--color-text-main)] group-hover:text-[var(--color-brand)] transition-colors">
      <a href={resolvePath(`/blog/${id}`)}>
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <p class="mt-2 text-[14px] text-[var(--color-text-secondary)] line-clamp-3 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-4 flex items-center justify-between pt-3 border-t border-[var(--color-border)] text-[13px]">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <Badge variant="subtle" size="sm">{tag}</Badge>
      ))}
    </div>

    <span class="text-[var(--color-brand)] font-medium inline-flex items-center gap-1.5 shrink-0">
      <span>Read article</span>
      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_forward</span>
    </span>
  </div>
</article>
