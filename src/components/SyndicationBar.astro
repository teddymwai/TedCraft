---
import BrandIcon from './BrandIcon.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  type: 'article' | 'learning-curve' | 'case-study';
}

const { title, description, tags, type } = Astro.props;
const currentUrl = Astro.url.href;
const canonicalUrl = currentUrl;

// Pre-formatted markdown frontmatter for Dev.to / Hashnode
const devToFrontmatter = `---
title: "${title.replace(/"/g, '\\"')}"
published: true
description: "${description.replace(/"/g, '\\"')}"
tags: ${tags.slice(0, 4).join(', ')}
canonical_url: ${canonicalUrl}
---
`;

const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(currentUrl);
---

<div class="mantra-card p-6 my-8 space-y-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-[13px]">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center w-9 h-9 rounded-[8px] bg-[var(--color-accent-badge)] border border-[var(--color-border-accent)] text-[var(--color-brand)] shrink-0">
        <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">link</span>
      </span>
      <div>
        <div class="font-medium text-[var(--color-text-main)]">Cross-posting & syndication</div>
        <div class="text-[var(--color-text-muted)] text-[12px] mt-0.5">
          Canonical URL: <code class="text-[11px] font-mono-tabular bg-[var(--color-bg-subtle)] px-1.5 py-0.5 rounded-[4px]">{canonicalUrl}</code>
        </div>
      </div>
    </div>

    <!-- Dev.to / Hashnode Copy Button (Apple HIG 44px Capsule Button) -->
    <button
      id="copy-syndication-btn"
      type="button"
      data-frontmatter={devToFrontmatter}
      class="hig-btn hig-btn-tinted !h-11 shrink-0"
      title="Copy frontmatter with canonical URL for Dev.to or Hashnode"
    >
      <span id="copy-btn-icon" class="material-symbols-outlined !text-[17px]" aria-hidden="true">content_copy</span>
      <span id="copy-btn-text">Copy Dev.to / Hashnode meta</span>
    </button>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-[var(--color-border)] text-[12px]">
    <div class="text-[var(--color-text-muted)]">
      Syndicate or reference this {type} with canonical attribution
    </div>

    <!-- Quick Share Capsule Pills -->
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hig-filter-pill"
        title="Share on X / Twitter"
      >
        <BrandIcon name="x" class="w-3.5 h-3.5" />
        <span>Share on X</span>
      </a>
      <a
        href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hig-filter-pill"
        title="Share on LinkedIn"
      >
        <BrandIcon name="linkedin" class="w-3.5 h-3.5" />
        <span>LinkedIn</span>
      </a>
      <a
        href="/rss.xml"
        class="hig-filter-pill"
        title="Subscribe via RSS"
      >
        <span class="material-symbols-outlined !text-[15px]" aria-hidden="true">rss_feed</span>
        <span>RSS feed</span>
      </a>
    </div>
  </div>
</div>

<script>
  function setupSyndicationCopy() {
    const btn = document.getElementById('copy-syndication-btn');
    const label = document.getElementById('copy-btn-text');
    const icon = document.getElementById('copy-btn-icon');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const frontmatter = btn.getAttribute('data-frontmatter') || '';
      try {
        await navigator.clipboard.writeText(frontmatter);
        const original = label.innerText;
        label.innerText = 'Copied frontmatter';
        if (icon) icon.innerText = 'check';
        setTimeout(() => {
          label.innerText = original;
          if (icon) icon.innerText = 'content_copy';
        }, 2500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }

  setupSyndicationCopy();
  document.addEventListener('astro:after-swap', setupSyndicationCopy);
</script>
