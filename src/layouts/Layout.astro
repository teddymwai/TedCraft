---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientCanvas from '../components/AmbientCanvas.astro';
import { getPersonEntity, getWebSiteEntity, getSiteRootUrl } from '../utils/schema';
import { resolvePath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showReadingProgress?: boolean;
  ambientCanvas?: boolean;
  jsonLd?: Record<string, any>;
}

const {
  title = "Thaddeus W. Mwai (aka Ted) | TedCraft · Software QA Lead & Senior Risk Strategist",
  description = "Software QA Lead and Senior Risk Strategist at CYBER RANGES. Showcasing high-assurance verification platforms, access governance engines, and technical post-mortems.",
  image = "/og-image.png",
  showReadingProgress = false,
  ambientCanvas = true,
  jsonLd,
} = Astro.props;

const siteRoot = getSiteRootUrl(Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteRoot);
const ogImageUrl = image.startsWith('http') ? image : new URL(resolvePath(image), Astro.site || siteRoot).href;
const activeJsonLd = jsonLd || {
  '@context': 'https://schema.org',
  '@graph': [
    getPersonEntity(siteRoot),
    getWebSiteEntity(siteRoot),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={resolvePath('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Newsreader (Display Serif), Instrument Sans (UI & Prose), JetBrains Mono (Figures & Code), Material Symbols Outlined (Pillar 02) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap"
    />

    <!-- Color Scheme & Anti-FOUC Script (modern-web-guidance: dark-mode, defaulting to dark obsidian luxury theme while allowing toggle) -->
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('color-scheme');
        const meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) {
          meta.content = stored === 'light' || stored === 'dark' ? stored : 'dark';
        }
      } catch (e) {
        // Safe fallback in restricted environments
      }
    </script>

    <!-- SEO & Open Graph -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Schema.org Entity Knowledge Graph (JSON-LD) for Semantic & AI-SEO Retrieval -->
    <script type="application/ld+json" set:html={JSON.stringify(activeJsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-[var(--color-brand)] selection:text-[var(--color-brand-fg)]">
    {ambientCanvas && <AmbientCanvas />}
    {showReadingProgress && <div id="scroll-progress" aria-hidden="true"></div>}
    <div id="site-shell">
      <Header />
      <main class="flex-1 py-8 sm:py-12">
        <slot />
      </main>
      <Footer />
    </div>

    {showReadingProgress && (
      <script>
        function setupScrollProgressFallback() {
          if (!CSS.supports('animation-timeline', 'scroll()')) {
            const progress = document.querySelector<HTMLElement>('#scroll-progress');
            if (!progress) return;

            const onScroll = () => {
              const scrollable = document.documentElement.scrollHeight - window.innerHeight;
              if (scrollable <= 0) {
                progress.style.transform = 'scaleX(0)';
                return;
              }
              const scrolled = window.scrollY;
              const ratio = Math.min(1, Math.max(0, scrolled / scrollable));
              progress.style.transform = `scaleX(${ratio})`;
            };

            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
          }
        }
        setupScrollProgressFallback();
        document.addEventListener('astro:after-swap', setupScrollProgressFallback);
      </script>
    )}
  </body>
</html>
